# OxiKernel vendor-security subconfig.
#
# Samsung's vendor security stack (integrity engines, extra LSMs, container
# encryption hooks, TrustZone integrity/oemflag drivers and the network
# container monitor) is no longer part of this tree, so those symbols do not
# exist any more and are not listed here.
#
# What is still in tree is the Samsung micro hypervisor glue (uH) together
# with RKP/KDP. AOSP boot chains do not load Samsung's hypervisor, so the
# feature stays compiled out; the source is kept for reference and for
# builds that do run the stock secure world.

# --- Samsung uH / RKP (source kept, not built) ---
# CONFIG_UH is not set
# CONFIG_UH_DEBUG is not set
# CONFIG_UH_RKP is not set
# CONFIG_RKP_KDP is not set
# CONFIG_RKP_NS_PROT is not set
# CONFIG_RKP_DMAP_PROT is not set
# CONFIG_RKP_TEST is not set
# CONFIG_KDP_TEST is not set
# CONFIG_UH_RKP_FIMC_CHECK is not set
# CONFIG_UH_LKMAUTH is not set
# CONFIG_UH_LKM_BLOCK is not set

# Keep generic kernel integrity (IMA) infrastructure; it is not Samsung.
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y
