# OxiKernel de-Knox / de-Samsung security subconfig.
#
# Goal: strip every Samsung/Knox security feature from the build. These are
# gated by the symbols below; turning them off compiles none of the Knox code.
# The matching source trees are removed separately (see commit/deletion pass).

# --- Legacy Knox SDP / DDAR (Sensitive Data Protection, Dual-DAR) ---
# Tied to Samsung's old fscrypt ABI and conflicts with the Android 16
# fscrypt/fs-verity stack. AOSP/GSI does not use it.
# CONFIG_FSCRYPT_SDP is not set
# CONFIG_SDP is not set
# CONFIG_SDP_KEY_DUMP is not set
# CONFIG_SDP_IOCTL_PRIV is not set
# CONFIG_DDAR is not set
# CONFIG_DDAR_USER_PREPARE is not set

# --- Knox NCM (Network Container Monitor / NPA) ---
# CONFIG_KNOX_NCM is not set

# --- RKP (Real-time Kernel Protection, Samsung/Knox hypervisor) ---
# Deeply integrated; disabled here, source left in tree but uncompiled.
# CONFIG_RKP_KDP is not set
# CONFIG_RKP_NS_PROT is not set
# CONFIG_RKP_DMAP_PROT is not set
# CONFIG_RKP_TEST is not set
# CONFIG_RKP_CFP_JOPP is not set
# CONFIG_UH_RKP is not set
# CONFIG_UH_RKP_FIMC_CHECK is not set
# CONFIG_KNOX_KAP is not set

# --- FIVE (File-based Integrity Verification Engine, Samsung) ---
# CONFIG_FIVE is not set
# CONFIG_FIVE_PA_FEATURE is not set
# CONFIG_FIVE_USE_TZDEV is not set
# CONFIG_FIVE_USE_TRUSTONIC is not set
# CONFIG_FIVE_USE_EMULATOR is not set
# CONFIG_FIVE_USE_QSEE is not set
# CONFIG_FIVE_USE_QSEECOM is not set
# CONFIG_FIVE_TEE_DRIVER is not set
# CONFIG_FIVE_DEBUG is not set
# CONFIG_FIVE_EARLY_LOAD_TRUSTED_APP is not set
# CONFIG_FIVE_TRUSTED_KEYRING is not set
# CONFIG_FIVE_GKI_10 is not set
# CONFIG_FIVE_GKI_20 is not set
# CONFIG_FIVE_AUDIT_VERBOSE is not set
# CONFIG_FIVE_DSMS is not set
# CONFIG_FIVE_CERT_ENG is not set
# CONFIG_FIVE_SIGN_TA is not set

# --- ICD (Integrity Check Driver, Samsung) ---
# CONFIG_ICD is not set
# CONFIG_ICD_USE_TZDEV is not set
# CONFIG_ICD_USE_TRUSTONIC is not set
# CONFIG_ICD_USE_QSEECOM is not set

# --- PROCA (Process Certificate, Samsung) + GAF ---
# CONFIG_PROCA is not set
# CONFIG_SECURITY_PROCA is not set
# CONFIG_PROCA_DEBUG is not set
# CONFIG_PROCA_GKI_10 is not set
# CONFIG_PROCA_S_OS is not set
# CONFIG_GAF_V3 is not set
# CONFIG_GAF_V4 is not set
# CONFIG_GAF_V5 is not set
# CONFIG_GAF_V6 is not set

# --- DEFEX (Samsung LSM) ---
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_DEFEX_KERNEL_ONLY is not set

# --- DSMS (Samsung Diagnostics/security monitor) ---
# CONFIG_SECURITY_DSMS is not set

# --- sdcardfs Knox support ---
# CONFIG_SDCARD_FS_SUPPORT_KNOX is not set

# Keep generic kernel integrity (IMA) infrastructure; it is not Samsung.
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_INTEGRITY_ASYMMETRIC_KEYS=y
