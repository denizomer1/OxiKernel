# Mint kernel configuration - Google GSI / Android 12-17 GSI support
#
# Enables the kernel options required by the official Google Generic
# System Image (GSI) and phhGSI-style AOSP builds so a clean vendor can
# boot a stock Android system.img on Exynos9610 (A50).
#
# This configuration targets Android 12 through Android 17 (API 31-37).
# Backports from the Motorola exynos9610-lineage-23.2 (4.14.357-openela)
# tree provide fs-verity and binderfs support that Android 16+ GSI
# requires, which are otherwise missing from the base 4.14.336 tree.

# Overlay filesystem: GSI mounts /system as an overlay over /.
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y

# /dev/mem: some GSI / vendor HAL helpers expect it.
CONFIG_DEVMEM=y

# Android binder: GSI expects the standard binder,hwbinder,vndbinder set.
# binderfs (backported) lets the framework mount /dev/binderfs; the legacy
# char devices are still created for compatibility.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# NOTE: fs-verity backport requires VFS-layer changes (struct inode /
# super_block members, IS_VERITY) that are not yet ported. It is left
# disabled for now; GSI falls back to DM_VERITY (device-mapper verity),
# which is sufficient for booting. fs-verity will be added in a later
# stage together with the required VFS patches.
# CONFIG_FS_VERITY is not set
# CONFIG_FS_VERITY_BUILTIN_SIGNATURES is not set

# Android verity target: GSI's vbmeta/verity + AVB metadata.
CONFIG_DM_VERITY=y
CONFIG_DM_ANDROID_VERITY=y
CONFIG_DM_VERITY_AVB=y

# squashfs: a few GSI variants ship as squashfs.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y

# tmpfs + devtmpfs: mandatory for the GSI early-userspace mount of /.
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# SELinux: GSI ships its own policy; keep the kernel LSM hooks enabled
# so the GSI enforcing policy can load. Permissive is applied by the
# selinux-permissive variant subconfig if requested.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y

# ION: vendor HALs (camera, media, gralloc) under GSI rely on it.
CONFIG_ION=y

# Low memory killer: GSI / Android framework expects the in-kernel
# lowmemorykiller to reap background processes.
CONFIG_ANDROID_LOW_MEMORY_KILLER=y

# Seccomp syscall filtering used by the GSI zygote / mediaserver.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# TCP_DIAG / INET_DIAG are already =y; keep FQ for GSI networking.
CONFIG_NET_SCH_FQ=y
