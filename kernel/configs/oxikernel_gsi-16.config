# OxiKernel configuration - Android 16 (API 36) GSI support
#
# Enables the kernel options required by the official Google Generic System
# Image (GSI) for Android 16 (API level 36) and phhGSI-style AOSP builds so a
# clean vendor can boot a stock Android system.img on Exynos9610 (A50).
#
# This configuration targets Android 16 (API 36). It is derived from the
# gsi-12 configuration and adds the few extra symbols Android 16 GSI expects
# that are not already covered there. The fs-verity and binderfs backports
# from the Motorola exynos9610-lineage-23.2 (4.14.357-openela) tree are still
# required and are inherited from the shared GSI options below.

# --- Shared GSI base (identical to gsi-12) ---------------------------------

# Overlay filesystem: GSI mounts /system as an overlay over /.
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y

# /dev/mem: some GSI / vendor HAL helpers expect it.
CONFIG_DEVMEM=y

# Android binder: GSI expects the standard binder,hwbinder,vndbinder set.
# binderfs (backported) lets the framework mount /dev/binderfs; the legacy
# char devices are still created for compatibility.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# fs-verity: backported from 4.14.357-openela (Motorola exynos9610-lineage-23.2).
# Android 16 GSI requires fs-verity on certain system/vendor files.
# Builtin signatures let the GSI verify against its own .fs-verity keyring.
CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_UNICODE=y

# Android verity target: GSI's vbmeta/verity + AVB metadata.
CONFIG_DM_VERITY=y
CONFIG_DM_ANDROID_VERITY=y
CONFIG_DM_VERITY_AVB=y

# squashfs: a few GSI variants ship as squashfs.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y

# tmpfs + devtmpfs: mandatory for the GSI early-userspace mount of /.
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# SELinux: GSI ships its own policy; keep the kernel LSM hooks enabled
# so the GSI enforcing policy can load. Permissive is applied by the
# selinux-permissive variant subconfig if requested.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y

# ION: vendor HALs (camera, media, gralloc) under GSI rely on it.
CONFIG_ION=y

# Low memory killer: GSI / Android framework expects the in-kernel
# lowmemorykiller to reap background processes.
CONFIG_ANDROID_LOW_MEMORY_KILLER=y

# Seccomp syscall filtering used by the GSI zygote / mediaserver.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# TCP_DIAG / INET_DIAG are already =y; keep FQ for GSI networking.
CONFIG_NET_SCH_FQ=y

# VoWiFi / IMS: ePDG uses IPsec/XFRM interfaces and policy migration when
# handing calls between cellular and Wi-Fi. Android netd and carrier rules
# also require policy routing, packet marks, cgroups and DSCP matching.
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_MIGRATE=y
CONFIG_NET_KEY_MIGRATE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XT_MATCH_ESP=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_DSCP=y
CONFIG_NETFILTER_XT_TARGET_DSCP=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_TUN=y
CONFIG_PPP=y

# --- Android 16 (API 36) specific additions --------------------------------

# EROFS: the Android 16 GSI system image is shipped as EROFS by default
# (and many vendor images on newer devices use it as well). Without it the
# first-stage init cannot mount /system and the device reboots.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y

# Loop devices: GSI / adb remount and some overlay setups loop-mount images.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

# Android paranoid network: Android 16 GSI frameworks expect the per-uid
# network permission hooks to be present.
CONFIG_ANDROID_PARANOID_NETWORK=y

# Namespaces used by the GSI microdroid / virtualization and app sandboxing.
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# f2fs: GSI userdata late-mount still expects f2fs support on A16.
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y

# CONFIG_SDCARD_FS is intentionally left disabled: Android 11+ uses the
# in-kernel sdcardfs replacement only on older trees; A16 GSI relies on
# the fuse-based media store instead.

# --- Power management / shutdown fix ---------------------------------------
# CONFIG_SEC_REBOOT must stay disabled. When it is set, drivers/soc/samsung/
# exynos-reboot.c skips registering exynos_power_off() as pm_power_off, so the
# kernel can never drive PS_HOLD low and the PMIC never truly powers off. The
# device then "shuts down" (screen off) but cannot be powered back on, and
# recovery/reboot commands fail the same way. Disabling it lets the Exynos
# power-off path reach the PMIC correctly.
# CONFIG_SEC_REBOOT is not set
